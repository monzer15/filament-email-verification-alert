{
    "name": "monzer/filament-email-verification-alert",
    "description": "Send Email verifications on the fly!",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Monzer Osman",
            "email": "monzerosman15@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "filament/support": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Monzer\\FilamentEmailVerificationAlert\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Monzer\\FilamentEmailVerificationAlert\\EmailVerificationAlertServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
}
